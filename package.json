{
  "name": "dsh-qbetter-config",
  "version": "2.0.0",
  "description": "Better config hub for DeepSeek Harness: one page showing sandbox mode, default model, workspaces, settings namespaces and copy-ready composition templates.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "license": "MIT",
  "author": "qf",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "config",
    "settings",
    "hub",
    "qf"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/2128627267/dsh-qbetter-config.git"
  },
  "homepage": "https://github.com/2128627267/dsh-qbetter-config#readme",
  "bugs": {
    "url": "https://github.com/2128627267/dsh-qbetter-config/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
